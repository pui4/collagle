<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>collagle</title>
    <link rel="icon" type="image/x-png" href="static/icons/icon.png">
    <link rel="stylesheet" href="static/base.css">
    {% block head %}{% endblock %}
</head>
<body>
     <svg width="0" height="0" style="position:absolute">
        <filter id="wobble">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="3" result="noise"/>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
    </svg>

    <div class="border topborder">
        <ul class="topbar">
            <li><a href="/"><img src="/static/icons/logo.png" class="logo" title="Home"></a></li>
            <li><a href="/gallery"><img src="/static/icons/world.png" class="logo" title="Gallery"></a></li>
            <li class="middle">
                {% block topbar %}{% endblock %}
            </li>
            <li class="end"><img src="/static/icons/questionicon.svg" class="logo" style="cursor: pointer;" onclick="help_clicked()" title="Help"></li>
        </ul>
    </div>

    {% block content %}{% endblock %}

    <div id="help_modal" class="modal_ctn">
        <div class="border">
            <div class="modal">
                <p class="help_txt">lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol lolol </p>
                <div class="border help_close"><p class="button" onclick="help_close()">Close</p></div>
            </div>
        </div>
    </div>

    <script src="/static/base.js"></script>
</body>
</html>