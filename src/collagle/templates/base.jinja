<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>collagle</title>
    <link rel="icon" type="image/x-png" href="{{ url_for('static', filename='icons/icon.png') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='base.css') }}">

    <meta property="og:title" content="collagle" />
    <meta property="og:description" content="Daily shapes and colours" />
    <meta property="og:image" content="{{ url_for('static', filename='icons/logo.png') }}" />
    <meta property="og:url" content="https://collagle.net" />
    {% block head %}{% endblock %}
</head>
<body>
     <svg width="0" height="0" style="position:absolute">
        <filter id="wobble">
            <feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="3" seed="3" result="noise"/>
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="10" xChannelSelector="R" yChannelSelector="G"/>
        </filter>
    </svg>

    <div class="border topborder">
        <ul class="topbar">
            <li><a href="/"><img src="/static/icons/logo.png" class="logo" title="Home"></a></li>
            <li><a href="/gallery"><img src="/static/icons/galleryicon.svg" class="logo" title="Gallery"></a></li>
            <li class="middle">
                {% block topbar %}{% endblock %}
            </li>
            <li class="end">
                <a href="https://ko-fi.com/pooeyfour"><img src="/static/icons/kofi_symbol.png" class="logo" style="padding-right: 20px;"></a>
                <img src="/static/icons/questionicon.svg" class="logo" style="cursor: pointer;" onclick="help_clicked()" title="Help">
            </li>
        </ul>
    </div>

    {% block content %}{% endblock %}

    <div id="help_modal" class="modal_ctn">
        <div class="border">
            <div class="modal">
                <p class="help_txt">
                    just select symbols along the bottom to place them upon your canvas. 
                    <br><br>
                    click to select and drag to move around, grab the corners to scale and rotate with the extended knob. use the up and down arrows to control what layer a piece is on. 
                    <br><br>
                    click the colours on the right to change the colour of your selected symbol.
                    <br><br>
                    once you've made something, press the tick icon to title and submit your piece anonymously to be viewed in the gallery!
                    </p><br>
                <div class="border help_close"><p class="button" onclick="help_close()">Close</p></div>
            </div>
        </div>
    </div>

    <script src="/static/base.js"></script>
</body>
</html>