{% extends "base.jinja" %}

{% block head %}
    <script src="https://unpkg.com/konva@10/konva.min.js"></script>
    <link rel="stylesheet" href="static/builder.css">
{% endblock %}

{% block content %}
    <div id="container"></div>

    <ul id="pallet">
    </ul>

    <ul id="symbols">
    </ul>

    <ul>
        <li><img src="static/arrowicon.svg" class="symb_icon" onclick=move_up()></li>
        <li><img src="static/arrowicon.svg" style="transform: rotate(180deg);" class="symb_icon" onclick=move_down()></li>
        <li><img src="static/binicon.svg" class="symb_icon" onclick=remove()></li>
    </ul>
    <img src="static/tickicon.svg" class="symb_icon" onclick="submit()">

    <input type="text" id="subtitle">

    <script src="static/builder.js"></script>
{% endblock %}