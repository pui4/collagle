{% extends "base.jinja" %}

{% block head %}
    <script src="https://unpkg.com/konva@10/konva.min.js"></script>
    <link rel="stylesheet" href="static/builder.css">
{% endblock %}

{% block topbar %}
    <p style="font-size: larger;">Create something!</p>
{% endblock %}

{% block content %}
    <div class="main_ctn">
        <div class="canvas_ctn">
            <div class="border">
                <ul class="items vert toolbar">
                    <li style="padding-top: 15px;"><img src="static/icons/tickicon.svg" class="toolbar_icon" onclick="submit()" title="Submit"></li>
                    <li><img src="static/icons/arrowicon.svg" class="toolbar_icon" onclick=move_up() title="Move up a layer"></li>
                    <li><img src="static/icons/arrowicon.svg" style="transform: rotate(180deg);" class="toolbar_icon" onclick=move_down() title="Move down a layer"></li>
                    <li><img src="static/icons/flipicon.svg" class="toolbar_icon" onclick=flip_hori() title="Flip horizontally"></li>
                    <li><img src="static/icons/flipicon.svg" style="transform: rotate(90deg);" class="toolbar_icon" onclick=flip_vert() title="Flip vertically"></li>
                    <li><img src="static/icons/binicon.svg" class="toolbar_icon" onclick=remove() title="Delete"></li>
                    <li><img src="static/icons/undo.svg" class="toolbar_icon disabled" onclick="undo()" id="undo" title="Undo"></li>
                    <li><img src="static/icons/undo.svg" class="toolbar_icon flipped disabled" onclick="redo()" id="redo" title="Redo"></li>
                </ul>
            </div>
            <div id="container" class="border"></div>
                <div class="border">
                    <ul id="pallet" class="items vert" style="overflow-x: hidden;"></ul>
                </div>
        </div>
        <div class="border">
            <ul id="symbols" class="items hori"></ul>
        </div>
    </div>

    <div id="modal" class="modal_ctn">
        <div class="border">
            <div class="modal">
                <div style="margin-top: auto;">
                    <div id="frame"></div>
                    <p style="text-align: center;">Finalize piece?</p>
                </div>
                <div style="margin-top: auto;">
                    <div class="border">
                        <input type="text" id="subtitle" placeholder="Caption" maxlength="500">
                    </div>
                    <div class="buttons">
                        <div class="border"><p class="button" onclick="modal_submit()">Submit</p></div>
                        <div class="border"><p class="button" onclick="modal_cancel()">Cancel</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="static/builder.js"></script>
{% endblock %}